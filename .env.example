# --- GLOBAL / VERSIONS ---
ELASTIC_VERSION=9.3.2
KIBANA_VERSION=9.3.2
ELASTIC_SECURITY_ENABLED=false
ELASTIC_ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- MONGODB CONFIG ---
# Valores para servicios dentro de Docker Compose.
# Desde contenedores, Mongo se alcanza por el nombre del servicio `mongodb`, no por `localhost`.
# Si ejecutas scripts directamente en tu host, usa los scripts del repo que ya remapean este host cuando hace falta.
# Root credentials (used for initial setup).
MONGO_INITDB_ROOT_USERNAME=newsradar_root
MONGO_INITDB_ROOT_PASSWORD=change_me_root_pwd
MONGO_INITDB_DATABASE=admin
MONGO_HOST=mongodb
MONGO_PORT=27017

# Application credentials (used by Backend and RSS-Worker)
MONGO_APP_USER=newsradar_app
MONGO_APP_PASSWORD=change_me_app_pwd
MONGO_APP_DB=newsradar
# Admin semilla creada por el bootstrap inicial de MongoDB.
NEWSRADAR_ADMIN_EMAIL=AdminDefault@newsradar.com
# Hash bcrypt de la clave inicial del admin. Si no se define, se usa la de `NewsRadar2026`.
# NEWSRADAR_ADMIN_PASSWORD_HASH=$2b$12$...
# No definas MONGODB_URI aqui para Docker Compose salvo que quieras sobreescribir toda la conexion.
# El backend la construye desde las variables anteriores con el host interno correcto.

# --- ELASTICSEARCH CONFIG ---
ELASTIC_EXPOSE_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_ENTRADAS=rss_entradas_idx
ELASTICSEARCH_INDEX_FUENTES=rss_fuentes_idx

# --- BACKEND CONFIG ---
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
BACKEND_EXPOSE_PORT=8000
LOG_LEVEL=info

# --- SMTP / MAIL CONFIG (Fill these in!) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@newsradar.com

# --- FRONTEND CONFIG ---
FRONTEND_NODE_ENV=development
FRONTEND_PORT=5173
FRONTEND_EXPOSE_PORT=5173
# URL publica que abrira el navegador desde tu maquina host.
VITE_API_BASE_URL=http://localhost:8000
# URL base del frontend (usada por el backend para construir enlaces de verificacion/reset).
FRONTEND_URL=http://localhost:5173

# --- NVIDIA AI CONFIG ---
VITE_NVIDIA_API_KEY=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


# --- RSS WORKER CONFIG ---
RSS_WORKER_INTERVAL_SECONDS=300
RSS_WORKER_RUN_ONCE=false
RSS_WORKER_UVICORN_PORT=8000
RSS_WORKER_UVICORN_EXPOSE_PORT=12670

# --- ALERT WORKER CONFIG ---
ALERT_WORKER_INTERVAL_SECONDS=60
ALERT_WORKER_RUN_ONCE=false
