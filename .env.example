# --- GLOBAL / VERSIONS ---
ELASTIC_VERSION=9.3.2
KIBANA_VERSION=9.3.2
ELASTIC_SECURITY_ENABLED=false
ELASTIC_ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- MONGODB CONFIG ---
# Root credentials (used for initial setup).
MONGO_INITDB_ROOT_USERNAME=newsradar_root
MONGO_INITDB_ROOT_PASSWORD=change_me_root_pwd
MONGO_INITDB_DATABASE=admin
MONGO_HOST=mongodb
MONGO_PORT=27017

# Application credentials (used by Backend and RSS-Worker)
MONGO_APP_USER=newsradar_app
MONGO_APP_PASSWORD=change_me_app_pwd
MONGO_APP_DB=newsradar

# --- ELASTICSEARCH CONFIG ---
ELASTIC_EXPOSE_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_ENTRADAS=rss_entradas_idx
ELASTICSEARCH_INDEX_FUENTES=rss_fuentes_idx

# --- BACKEND CONFIG ---
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
BACKEND_EXPOSE_PORT=8000
LOG_LEVEL=info

# --- SMTP / MAIL CONFIG (Fill these in!) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@newsradar.com

# --- FRONTEND CONFIG ---
FRONTEND_NODE_ENV=development
FRONTEND_PORT=5173
FRONTEND_EXPOSE_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- RSS WORKER CONFIG ---
RSS_WORKER_INTERVAL_SECONDS=300
RSS_WORKER_RUN_ONCE=false
RSS_WORKER_UVICORN_PORT=12000
