    <guid isPermaLink="true">https://www.dsca.gob.es/%3Cdiv%20class%3D%22img-slide%22%3E%20%20%3Cimg%20loading%3D%22lazy%22%20src%3D%22/sites/default/files/styles/carrousel/public/carrousel/pexels-3170155-9462402_0.jpg?itok=WSXLvC0G%22%20width%3D%22457%22%20height%3D%22304%22%20alt%3D%22Bebida%22%20class%3D%22image-style-carrousel%22%20/%3E___%3C/div%3E_%3Cdiv%20class%3D%22tx-slide%22%3E_%3Cdiv%20class%3D%22title-slide%22%3EConsumo%20prohibir%C3%A1%20la%20venta%20de%20bebidas%20energ%C3%A9ticas%20a%20menores%20de%2016%20a%C3%B1os%20%3C/div%3E%20_%3Cdiv%20class%3D%22date-slide%22%3E%3Ctime%20datetime%3D%222026-02-25T11%3A05%3A47%2001%3A00%22%20class%3D%22datetime%22%3E25%20de%20Febrero%20de%202026%3C/time%3E_%3C/div%3E_%3Cdiv%20class%3D%22intro-slide%22%3E%20%3C/div%3E_%3Cdiv%20class%3D%22vermas%22%3E/es/comunicacion/notas-prensa/consumo-prohibira-venta-bebidas-energeticas-menores-16-anos%3C/div%3E_%3C/div%3E</guid>
